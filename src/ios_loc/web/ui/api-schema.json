{
  "components": {
    "schemas": {
      "DeviceStatus": {
        "properties": {
          "connected": {
            "title": "Connected",
            "type": "boolean"
          },
          "detail": {
            "title": "Detail",
            "type": "string"
          },
          "reason": {
            "title": "Reason",
            "type": "string"
          }
        },
        "required": [
          "connected",
          "reason",
          "detail"
        ],
        "title": "DeviceStatus",
        "type": "object"
      },
      "FixOut": {
        "properties": {
          "distance_m": {
            "title": "Distance M",
            "type": "number"
          },
          "elapsed_s": {
            "title": "Elapsed S",
            "type": "number"
          },
          "lat": {
            "title": "Lat",
            "type": "number"
          },
          "lon": {
            "title": "Lon",
            "type": "number"
          },
          "paused": {
            "title": "Paused",
            "type": "boolean"
          },
          "speed_mps": {
            "title": "Speed Mps",
            "type": "number"
          }
        },
        "required": [
          "elapsed_s",
          "lat",
          "lon",
          "distance_m",
          "speed_mps",
          "paused"
        ],
        "title": "FixOut",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "PaceOut": {
        "description": "A selectable pace. Carries `speed_mps` so the GUI can show what picking\nit actually means without a second request or a hardcoded copy of the\nbuilt-in speeds.",
        "properties": {
          "name": {
            "title": "Name",
            "type": "string"
          },
          "speed_mps": {
            "title": "Speed Mps",
            "type": "number"
          }
        },
        "required": [
          "name",
          "speed_mps"
        ],
        "title": "PaceOut",
        "type": "object"
      },
      "PinRequest": {
        "description": "A single point to hold the device at \u2014 the GUI's `ios-loc set`.",
        "properties": {
          "lat": {
            "maximum": 90.0,
            "minimum": -90.0,
            "title": "Lat",
            "type": "number"
          },
          "lon": {
            "maximum": 180.0,
            "minimum": -180.0,
            "title": "Lon",
            "type": "number"
          }
        },
        "required": [
          "lat",
          "lon"
        ],
        "title": "PinRequest",
        "type": "object"
      },
      "PlaceIn": {
        "properties": {
          "name": {
            "minLength": 1,
            "title": "Name",
            "type": "string"
          },
          "point": {
            "maxItems": 2,
            "minItems": 2,
            "prefixItems": [
              {
                "type": "number"
              },
              {
                "type": "number"
              }
            ],
            "title": "Point",
            "type": "array"
          }
        },
        "required": [
          "name",
          "point"
        ],
        "title": "PlaceIn",
        "type": "object"
      },
      "PlaceOut": {
        "properties": {
          "name": {
            "title": "Name",
            "type": "string"
          },
          "point": {
            "items": {
              "type": "number"
            },
            "title": "Point",
            "type": "array"
          }
        },
        "required": [
          "name",
          "point"
        ],
        "title": "PlaceOut",
        "type": "object"
      },
      "PlacesListOut": {
        "properties": {
          "places": {
            "items": {
              "$ref": "#/components/schemas/PlaceOut"
            },
            "title": "Places",
            "type": "array"
          }
        },
        "required": [
          "places"
        ],
        "title": "PlacesListOut",
        "type": "object"
      },
      "PresetIn": {
        "properties": {
          "costing": {
            "default": "pedestrian",
            "title": "Costing",
            "type": "string"
          },
          "loop": {
            "default": false,
            "title": "Loop",
            "type": "boolean"
          },
          "name": {
            "minLength": 1,
            "title": "Name",
            "type": "string"
          },
          "pace": {
            "default": "walk",
            "title": "Pace",
            "type": "string"
          },
          "waypoints": {
            "items": {
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "type": "array"
            },
            "minItems": 2,
            "title": "Waypoints",
            "type": "array"
          }
        },
        "required": [
          "name",
          "waypoints"
        ],
        "title": "PresetIn",
        "type": "object"
      },
      "PresetOut": {
        "properties": {
          "costing": {
            "title": "Costing",
            "type": "string"
          },
          "loop": {
            "title": "Loop",
            "type": "boolean"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "pace": {
            "title": "Pace",
            "type": "string"
          },
          "waypoints": {
            "items": {
              "items": {
                "type": "number"
              },
              "type": "array"
            },
            "title": "Waypoints",
            "type": "array"
          }
        },
        "required": [
          "name",
          "waypoints",
          "pace",
          "loop",
          "costing"
        ],
        "title": "PresetOut",
        "type": "object"
      },
      "PresetsListOut": {
        "properties": {
          "offline": {
            "title": "Offline",
            "type": "boolean"
          },
          "paces": {
            "items": {
              "$ref": "#/components/schemas/PaceOut"
            },
            "title": "Paces",
            "type": "array"
          },
          "presets": {
            "items": {
              "$ref": "#/components/schemas/PresetOut"
            },
            "title": "Presets",
            "type": "array"
          }
        },
        "required": [
          "presets",
          "paces",
          "offline"
        ],
        "title": "PresetsListOut",
        "type": "object"
      },
      "RerouteRequest": {
        "description": "Newly-appended waypoints only -- the running walk's current live\nposition is prepended server-side by `WalkService.reroute`.",
        "properties": {
          "waypoints": {
            "items": {
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "type": "array"
            },
            "minItems": 1,
            "title": "Waypoints",
            "type": "array"
          }
        },
        "required": [
          "waypoints"
        ],
        "title": "RerouteRequest",
        "type": "object"
      },
      "RouteRequest": {
        "properties": {
          "costing": {
            "default": "pedestrian",
            "title": "Costing",
            "type": "string"
          },
          "waypoints": {
            "items": {
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "type": "array"
            },
            "minItems": 2,
            "title": "Waypoints",
            "type": "array"
          }
        },
        "required": [
          "waypoints"
        ],
        "title": "RouteRequest",
        "type": "object"
      },
      "RouteResponse": {
        "properties": {
          "coords": {
            "items": {
              "items": {
                "type": "number"
              },
              "type": "array"
            },
            "title": "Coords",
            "type": "array"
          },
          "is_closed_loop": {
            "title": "Is Closed Loop",
            "type": "boolean"
          },
          "length_m": {
            "title": "Length M",
            "type": "number"
          }
        },
        "required": [
          "coords",
          "length_m",
          "is_closed_loop"
        ],
        "title": "RouteResponse",
        "type": "object"
      },
      "StartRequest": {
        "description": "Exactly one of `preset`, `waypoints`, or `path` \u2014 the API rejects any\nother combination. `waypoints` is routed through Valhalla; `path` is a\nliteral route walked exactly as given, no routing call.",
        "properties": {
          "costing": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Costing"
          },
          "duration_s": {
            "anyOf": [
              {
                "exclusiveMinimum": 0.0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Duration S"
          },
          "loop": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Loop"
          },
          "pace": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Pace"
          },
          "path": {
            "anyOf": [
              {
                "items": {
                  "maxItems": 2,
                  "minItems": 2,
                  "prefixItems": [
                    {
                      "type": "number"
                    },
                    {
                      "type": "number"
                    }
                  ],
                  "type": "array"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Path"
          },
          "preset": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Preset"
          },
          "scatter_m": {
            "default": 3.0,
            "maximum": 100.0,
            "minimum": 0.0,
            "title": "Scatter M",
            "type": "number"
          },
          "speed": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Speed"
          },
          "waypoints": {
            "anyOf": [
              {
                "items": {
                  "maxItems": 2,
                  "minItems": 2,
                  "prefixItems": [
                    {
                      "type": "number"
                    },
                    {
                      "type": "number"
                    }
                  ],
                  "type": "array"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Waypoints"
          }
        },
        "title": "StartRequest",
        "type": "object"
      },
      "StatsOut": {
        "properties": {
          "distance_m": {
            "title": "Distance M",
            "type": "number"
          },
          "elapsed_s": {
            "title": "Elapsed S",
            "type": "number"
          },
          "laps": {
            "title": "Laps",
            "type": "integer"
          },
          "reconnects": {
            "title": "Reconnects",
            "type": "integer"
          },
          "ticks": {
            "title": "Ticks",
            "type": "integer"
          }
        },
        "required": [
          "elapsed_s",
          "distance_m",
          "laps",
          "reconnects",
          "ticks"
        ],
        "title": "StatsOut",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      },
      "WalkState": {
        "enum": [
          "idle",
          "starting",
          "walking",
          "reconnecting",
          "finished",
          "error",
          "pinned"
        ],
        "title": "WalkState",
        "type": "string"
      },
      "WalkStatus": {
        "properties": {
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error"
          },
          "fix": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/FixOut"
              },
              {
                "type": "null"
              }
            ]
          },
          "length_m": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Length M"
          },
          "loop": {
            "default": false,
            "title": "Loop",
            "type": "boolean"
          },
          "pace": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Pace"
          },
          "preset_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Preset Name"
          },
          "route": {
            "items": {
              "items": {
                "type": "number"
              },
              "type": "array"
            },
            "title": "Route",
            "type": "array"
          },
          "state": {
            "$ref": "#/components/schemas/WalkState"
          },
          "stats": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/StatsOut"
              },
              {
                "type": "null"
              }
            ]
          },
          "trail": {
            "items": {
              "$ref": "#/components/schemas/FixOut"
            },
            "title": "Trail",
            "type": "array"
          }
        },
        "required": [
          "state"
        ],
        "title": "WalkStatus",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "ios-loc",
    "version": "1"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/device": {
      "get": {
        "operationId": "device_status_api_device_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DeviceStatus"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Device Status"
      }
    },
    "/api/pin": {
      "post": {
        "operationId": "set_pin_api_pin_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PinRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WalkStatus"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Set Pin"
      }
    },
    "/api/places": {
      "get": {
        "operationId": "list_places_api_places_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PlacesListOut"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "List Places"
      },
      "post": {
        "operationId": "create_place_api_places_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PlaceIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PlaceOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Create Place"
      }
    },
    "/api/places/{name}": {
      "delete": {
        "operationId": "remove_place_api_places__name__delete",
        "parameters": [
          {
            "in": "path",
            "name": "name",
            "required": true,
            "schema": {
              "title": "Name",
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Remove Place"
      }
    },
    "/api/presets": {
      "get": {
        "operationId": "list_presets_api_presets_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PresetsListOut"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "List Presets"
      },
      "post": {
        "operationId": "create_preset_api_presets_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PresetIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PresetOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Create Preset"
      }
    },
    "/api/presets/{name}": {
      "delete": {
        "operationId": "remove_preset_api_presets__name__delete",
        "parameters": [
          {
            "in": "path",
            "name": "name",
            "required": true,
            "schema": {
              "title": "Name",
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Remove Preset"
      }
    },
    "/api/route": {
      "post": {
        "operationId": "build_route_api_route_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RouteRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RouteResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Build Route"
      }
    },
    "/api/walk": {
      "delete": {
        "operationId": "stop_walk_api_walk_delete",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WalkStatus"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Stop Walk"
      },
      "get": {
        "operationId": "walk_status_api_walk_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WalkStatus"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Walk Status"
      },
      "post": {
        "operationId": "start_walk_api_walk_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/StartRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WalkStatus"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Start Walk"
      }
    },
    "/api/walk/route": {
      "patch": {
        "operationId": "reroute_walk_api_walk_route_patch",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RerouteRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WalkStatus"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Reroute Walk"
      }
    }
  }
}
